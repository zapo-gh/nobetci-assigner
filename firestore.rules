rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Doğrulama Yardımcısı: Firebase Auth oturumu açık mı?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Sistem ve Okul Yapılandırma Belgeleri (/config/*)
    match /config/{docId} {
      // admin_auth: Güvenlik koruması
      // 1. Doküman asla dışarıdan silinemez (delete: false)
      // 2. Güncelleme yapılırken passwordHash geçerli formatta olmak zorundadır
      allow read: if true;
      allow create: if docId != 'admin_auth' || (
        !exists(/databases/$(database)/documents/config/admin_auth) &&
        request.resource.data.data.passwordHash is string &&
        request.resource.data.data.passwordHash.size() >= 32
      );
      allow update: if docId != 'admin_auth' || (
        request.resource.data.data.passwordHash is string &&
        request.resource.data.data.passwordHash.size() >= 32
      );
      allow delete: if docId != 'admin_auth';
    }

    // Öğretmen Listesi
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if request.resource.data.teacherName is string
                            && request.resource.data.teacherName.size() > 0
                            && request.resource.data.teacherName.size() <= 100;
      allow delete: if true;
    }

    // Sınıf Listesi
    match /classes/{classId} {
      allow read: if true;
      allow create, update: if request.resource.data.className is string
                            && request.resource.data.className.size() > 0
                            && request.resource.data.className.size() <= 50;
      allow delete: if true;
    }

    // Mazeretli / Devamsız Kayıtları
    match /absents/{absentId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
                            && request.resource.data.name.size() > 0;
      allow delete: if true;
    }

    // Belirtilmeyen tüm koleksiyonlar varsayılan olarak engellenir
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
